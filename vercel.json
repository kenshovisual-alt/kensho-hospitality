{
  "rewrites": [
    {
      "source": "/((?!api|assets|.*\\..*).*)",
      "destination": "/$1.html"
    }
  ],
  "redirects": [
    { "source": "/index.html",                              "destination": "/",                                 "permanent": true },
    { "source": "/:path/index.html",                        "destination": "/:path",                            "permanent": true },
    { "source": "/servicios.html",                          "destination": "/servicios",                        "permanent": true },
    { "source": "/proyectos.html",                          "destination": "/proyectos",                        "permanent": true },
    { "source": "/planes.html",                             "destination": "/planes",                           "permanent": true },
    { "source": "/blog.html",                               "destination": "/blog",                             "permanent": true },
    { "source": "/recursos.html",                           "destination": "/recursos",                         "permanent": true },
    { "source": "/blog-agentes-ia.html",                    "destination": "/blog-agentes-ia",                  "permanent": true },
    { "source": "/blog-google-maps.html",                   "destination": "/blog-google-maps",                 "permanent": true },
    { "source": "/caso-estudio-formacion-restaurante.html", "destination": "/caso-estudio-formacion-restaurante","permanent": true },
    { "source": "/aviso-legal.html",                        "destination": "/aviso-legal",                      "permanent": true },
    { "source": "/privacidad.html",                         "destination": "/privacidad",                       "permanent": true },
    { "source": "/cookies.html",                            "destination": "/cookies",                          "permanent": true },
    { "source": "/precios.html",                             "destination": "/precios",                          "permanent": true }
  ]
}
